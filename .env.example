# Copy to .env and fill in. Never commit .env.
MYSQL_ROOT_PASSWORD=adconnect_root
MYSQL_USER=adconnect
MYSQL_PASSWORD=adconnect_pw

# HMAC secret shared by auth-service (signs) and api-gateway (verifies). 32+ bytes.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Stripe test mode (https://dashboard.stripe.com/test/apikeys). Leave empty to use the built-in mock gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional Google login (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
